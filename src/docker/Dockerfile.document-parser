FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim@sha256:4f5d923c9dcea037f57bda425dd209f3ec643da2f0b74227f68d09dab0b3bb36

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    UV_CACHE_DIR=/tmp/uv-cache \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    MINERU_HOME=/opt/mineru \
    MINERU_MODEL_SOURCE=local \
    MINERU_MODEL_SMALL_BACKEND=onnx \
    MINERU_TABLE_DEVICE=cpu \
    HF_HUB_OFFLINE=1 \
    PATH="/opt/venv/bin:$PATH"

# 解析只使用 MinerU base + ONNX CPU；模型文件由私有只读卷提供。
RUN apt-get update \
    && apt-get install --no-install-recommends -y libgl1 libglib2.0-0 libmagic1 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system crm && useradd --system --gid crm --home-dir /app crm \
    && mkdir -p /opt/venv /opt/mineru /work \
    && chown -R crm:crm /app /opt/venv /opt/mineru /work

COPY --chown=crm:crm pyproject.toml uv.lock ./
USER crm
RUN uv sync --frozen --no-dev --extra document-parser

COPY --chown=crm:crm . .

CMD ["python", "-m", "app.knowledge_base.document_parser_worker"]
