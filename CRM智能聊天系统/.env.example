# ==================== 应用基础配置 ====================
# 运行环境：development、test 或 production。
APP_ENV=development
# 应用名称，用于日志、监控和服务识别。
APP_NAME=crm-chat-system
# 当前应用版本号。
APP_VERSION=0.1.0
# 日志级别：DEBUG、INFO、WARNING、ERROR。
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30

# ==================== 数据库 ====================
# PostgreSQL 异步连接地址。Docker Compose 环境中使用服务名 postgres。
# 生产环境请替换用户名、密码、主机和数据库名，并通过安全配置注入。
DATABASE_URL=postgresql+asyncpg://crm:crm@postgres:5432/crm

# ==================== Redis ====================
# Redis 连接地址。Redis 用于 Refresh Token 撤销、缓存和后续异步任务支持。
REDIS_URL=redis://redis:6379/0

# ==================== MinIO / 对象存储 ====================
# MinIO 服务地址。Docker Compose 环境中使用服务名 minio 和容器端口 9000。
MINIO_ENDPOINT=minio:9000
# MinIO 访问密钥。生产环境必须替换默认值。
MINIO_ACCESS_KEY=minio
# MinIO 密钥。禁止提交真实密钥、在日志中输出或在测试报告中记录。
MINIO_SECRET_KEY=change-me-minio-password
# 用于 FAQ 导入和知识文档的默认存储桶名称。
MINIO_BUCKET=crm-files
# 是否使用 HTTPS 连接 MinIO：false 表示本地开发，生产环境通常应设为 true。
MINIO_SECURE=false

# Phase 4 指标和 Agent 自动处理。自动发送默认关闭；当前 Mock 平台不得开启为真实发送。
METRICS_POLL_SECONDS=300
CHAT_QUERY_LIMIT=10
CHAT_QUERY_WINDOW_SECONDS=60
CHAT_USER_CONCURRENCY=2
# 单次内部 AI 草稿 SSE 的总预算与保活间隔；心跳只保活连接，不包含业务数据。
CHAT_STREAM_TIMEOUT_SECONDS=180
CHAT_SSE_HEARTBEAT_SECONDS=15
# 仅由 integration/staging 专用压测叠加开启，生产环境必须保持 false。
SSE_LOAD_TEST_ENABLED=false
AUTO_REPLY_ENABLED=false
AUTO_REPLY_POLL_SECONDS=1
AUTO_REPLY_MAX_ATTEMPTS=3
# FAQ 导入文件上限，单位字节；默认 10 MiB。
KNOWLEDGE_IMPORT_MAX_BYTES=10485760
# FAQ 单文件最多导入行数。
KNOWLEDGE_IMPORT_MAX_ROWS=5000
# Phase 3 后台任务空闲轮询间隔，单位秒。
JOBS_POLL_SECONDS=1
# 营销扫描目标间隔，单位秒；任务首次处理 SLA 为 5 分钟。
MARKETING_POLL_SECONDS=60

# ==================== JWT 认证 ====================
# JWT 签名密钥。生产环境必须使用高强度随机值，并通过密钥管理系统注入。
JWT_SECRET_KEY=change-me-use-at-least-32-random-characters
# JWT 签名算法。当前默认使用 HS256，修改时必须同步评估密钥管理和兼容性。
JWT_ALGORITHM=HS256
# Access Token 有效期，单位为分钟。
ACCESS_TOKEN_EXPIRE_MINUTES=120
# Refresh Token 有效期，单位为天。
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==================== API 与跨域 ====================
# 允许访问后端 API 的前端来源，多个来源使用逗号分隔。
CORS_ORIGINS=http://localhost:3000
# 后端 API 统一路径前缀。
API_PREFIX=/v1
# 对外站点根地址。生产环境必须为 HTTPS，不能包含凭证、查询参数或片段。
PUBLIC_BASE_URL=http://localhost:3000

# ==================== 前端容器构建 ====================
# 默认使用 Docker Hub 官方 Node 20 LTS 镜像。受限网络可以改为企业镜像仓库、
# 已审核的镜像加速地址或通过 docker load 导入后使用的本地镜像标签。
FRONTEND_NODE_IMAGE=node:20.19.4-alpine3.22@sha256:df02558528d3d3d0d621f112e232611aecfee7cbc654f6b375765f72bb262799
# 默认使用 npm 官方 registry；企业网络可替换为内部 npm 代理仓库。
FRONTEND_NPM_REGISTRY=https://registry.npmjs.org

# ==================== 浏览器认证安全 ====================
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_WINDOW_SECONDS=900

# ==================== Phase 2 平台接入 ====================
# 生产环境默认为 false；契约级 Mock 发送仅可在明确授权后启用。
ALLOW_MOCK_PLATFORM_ADAPTERS=true
WEBHOOK_MAX_BODY_BYTES=1048576
WEBHOOK_MAX_RETRIES=3
WEBHOOK_POLL_SECONDS=1
WEBHOOK_PAYLOAD_RETENTION_DAYS=30
TIKTOK_APP_KEY=mock-app
# 仅供本地 Phase 2 TikTok Mock 签名回归；真实 Webhook 使用 TIKTOK_APP_SECRET。
TIKTOK_WEBHOOK_SECRET=change-me-tiktok
SHOPEE_WEBHOOK_SECRET=change-me-shopee
AMAZON_WEBHOOK_SECRET=change-me-amazon

# ==================== 真实 TikTok 生产接入 ====================
# 真实只读、Webhook 和人工普通消息已具备工程实现，但在真实店铺独立验收前仍默认关闭。
REAL_TIKTOK_READ_ENABLED=false
REAL_TIKTOK_WEBHOOK_ENABLED=false
# 只允许工作台人工二次确认的普通文本消息；开启时 AUTO_REPLY_ENABLED 必须保持 false。
REAL_TIKTOK_MESSAGE_WRITE_ENABLED=false
# 发券、地址修改、营销等高风险动作不属于 REAL-FS-04，必须保持 false。
REAL_TIKTOK_HIGH_RISK_WRITE_ENABLED=false
# App Secret、凭证加密密钥只能由服务端环境或密钥管理系统注入。
TIKTOK_SERVICE_ID=
TIKTOK_APP_SECRET=
# integration/staging/production 只能使用下列固定 HTTPS 地址；应用启动和 OAuth
# start/callback 都会校验，且必须与 TikTok Partner Center 配置逐字一致。
TIKTOK_OAUTH_REDIRECT_URI=https://www.hophorsefit.com/v1/integrations/tiktok/oauth/callback
# US 使用美国授权入口，其他市场使用 ROW。
TIKTOK_OAUTH_MARKET=ROW
TIKTOK_OAUTH_STATE_TTL_SECONDS=600
# Jobs Worker 每 5 分钟扫描一次，并在 Access Token 到期前 24 小时刷新。
TIKTOK_TOKEN_REFRESH_POLL_SECONDS=300
TIKTOK_TOKEN_REFRESH_LEAD_SECONDS=86400
TIKTOK_TOKEN_REFRESH_BATCH_SIZE=20
# 多个 Scope 使用英文逗号分隔；REAL-FS-03 至少需要授权店铺、订单、客服消息和物流读取。
TIKTOK_REQUIRED_SCOPES=seller.authorization.info,seller.order.info,seller.customer_service,seller.logistics
TIKTOK_CREDENTIAL_ENCRYPTION_KEY=
# 由云主机/NAT 网关实际分配并加入 TikTok IP 白名单；应用只校验格式，不负责分配公网 IP。
TIKTOK_EGRESS_IP=

# ==================== AI Agent Phase 1 ====================
# AI 默认关闭；未配置真实模型和密钥时不影响现有应用启动。
LLM_ENABLED=false
AI_SYNTHETIC_DEMO_ENABLED=false
# 仅允许获准的 integration/staging 隔离评测进程临时覆盖为 true；根环境和常驻服务必须保持 false。
LLM_LIVE_EVAL=false
# 翻译会增加模型调用和时延，默认不进入 SSE 关键路径。
AI_TRANSLATION_ENABLED=false
# AI 弃单/中差评文案默认关闭，只有安全门禁通过后才交给受控发送链路。
AI_MARKETING_ENABLED=false
LLM_PRIMARY_PROVIDER=deepseek
LLM_PRIMARY_MODEL=deepseek-v4-flash
LLM_FALLBACK_PROVIDER=deepseek
LLM_FALLBACK_MODEL=deepseek-v4-pro
# 真实密钥只能通过安全配置注入，禁止写入代码、日志、数据库和测试报告。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 短意图分类关闭思考模式，避免推理 Token 耗尽输出预算。
DEEPSEEK_THINKING_ENABLED=false
LLM_TIMEOUT_SECONDS=15
# 总调用预算上限为 3：主模型首次、主模型重试/结构重生成、备用模型。
LLM_MAX_ATTEMPTS=3
LLM_MAX_OUTPUT_TOKENS=256
# REAL-AI-05 使用显式、版本化的保守上界估算。以下为 DeepSeek V4 Flash
# 2026-08-16 起峰值时段、输入缓存未命中的美元单价；价格变化时必须整体升级版本。
LLM_INPUT_COST_PER_MILLION_USD=0.44
LLM_OUTPUT_COST_PER_MILLION_USD=1.32
LLM_PRICING_VERSION=deepseek-v4-2026-08-16-peak-cache-miss
LLM_PRICING_CURRENCY=USD
LLM_PRICING_BASIS=conservative_peak_cache_miss

# ==================== AI Agent Phase 2 / FAQ RAG ====================
# Embedding 与 LLM 独立启用；完成 014 迁移并启动 ai profile 后再开启。
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=local_bge
EMBEDDING_MODEL=BAAI/bge-m3
# 必须与 PostgreSQL knowledge_chunks.vector(1024) 完全一致。
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=15
EMBEDDING_MAX_ATTEMPTS=3
# RTX 4060 8 GB 建议从小批量开始压测，确认余量后再调整。
EMBEDDING_BATCH_SIZE=4
EMBEDDING_MAX_LENGTH=8192
# 内部令牌必须使用随机值，并同时注入 backend、jobs 和模型服务。
RETRIEVAL_MODEL_SERVICE_URL=http://retrieval-model-service:8010
RETRIEVAL_MODEL_SERVICE_TOKEN=
BGE_M3_MODEL_PATH=/models/bge-m3
BGE_RERANKER_MODEL_PATH=/models/bge-reranker-large
RETRIEVAL_MODEL_DEVICE=auto
RETRIEVAL_MODEL_USE_FP16=true
# 开启后启动时重新计算约 4.5 GB 权重哈希，安全性更高但冷启动更慢。
RETRIEVAL_MODEL_VERIFY_HASHES=false
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=512
RERANKER_MAX_ATTEMPTS=2
# API 就绪探针检查单个依赖的最大等待时间，单位秒。
READINESS_TIMEOUT_SECONDS=3
# Dense 与 pg_trgm 词法各召回 20 条，经 RRF 融合为 20 条候选，再重排 Top 5。
RAG_DENSE_TOP_K=20
RAG_LEXICAL_TOP_K=20
RAG_CANDIDATE_TOP_K=20
RAG_TOP_K=5
RAG_RRF_K=60
# BGE-M3 与 pg_trgm 的暂定安全门禁；正式生产值必须由项目评测集校准。
RAG_MIN_SCORE=0.52
RAG_MIN_LEXICAL_SCORE=0.10
RAG_MAX_CONTEXT_TOKENS=6000
AGENT_AUTO_REPLY_THRESHOLD=0.80
AGENT_HUMAN_REVIEW_THRESHOLD=0.60

# ==================== 生产 Compose 入口 ====================
# 前端构建时使用的公开 API 地址，必须与 HTTPS 代理路径一致。
PUBLIC_API_BASE_URL=https://www.hophorsefit.com/v1
# 宿主机证书目录必须位于仓库外，包含 fullchain.pem 和 privkey.pem。
TLS_CERT_DIR=
# 生产/预发布服务器仓库外模型根目录；必须包含 bge-m3/pytorch_model.bin 和
# bge-reranker-large/model.safetensors。推荐 Linux 路径：/srv/crm/models。
RETRIEVAL_MODEL_ASSET_DIR=
# 生产数据库容器初始化变量；正式值由发布环境注入。
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=
# 最终 main 提交 f7c0f9f9 的 GHCR 发布摘要；仓库外 staging 配置必须显式同步并复核。
BACKEND_IMAGE=ghcr.io/cp11-gh/crm-backend@sha256:30f3a6816f718a92cd241330458124ea8b7b5407aafb1f533bcd0044e56914a9
FRONTEND_IMAGE=ghcr.io/cp11-gh/crm-frontend@sha256:c24b385250d61729667f372da1f63397a1b564019969d5bf424fff0682a910a0
RETRIEVAL_MODEL_SERVICE_IMAGE=ghcr.io/cp11-gh/crm-retrieval-model-service@sha256:e13818dfad09cfa565a6764024628a262e48a9089a37b6f8b517fb81997a1fcf
# 外部镜像固定 Docker Hub 多架构清单摘要；更新摘要必须作为独立受审代码变更。
POSTGRES_IMAGE=pgvector/pgvector:0.8.0-pg16@sha256:a132765ec351c65111b5b675928a3a0515a466a40f97277329db8b8209ad8bc9
REDIS_IMAGE=redis:7.4.2-alpine@sha256:02419de7eddf55aa5bcf49efb74e88fa8d931b4d77c07eff8a6b2144472b6952
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z@sha256:a1ea29fa28355559ef137d71fc570e508a214ec84ff8083e39bc5428980b015e
NGINX_IMAGE=nginx:1.27.5-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
