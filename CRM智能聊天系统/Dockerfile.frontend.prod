ARG NODE_IMAGE=node:20.19.4-alpine3.22@sha256:df02558528d3d3d0d621f112e232611aecfee7cbc654f6b375765f72bb262799
FROM ${NODE_IMAGE} AS dependencies
ARG NPM_REGISTRY=https://registry.npmjs.org
WORKDIR /app
COPY package*.json ./
RUN npm ci --registry=${NPM_REGISTRY}

FROM dependencies AS builder
ARG NEXT_PUBLIC_API_BASE_URL=/v1
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL} NEXT_TELEMETRY_DISABLED=1
COPY . .
RUN mkdir -p public && npm run build

FROM ${NODE_IMAGE} AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN addgroup -S crm && adduser -S crm -G crm
COPY --from=builder --chown=crm:crm /app/public ./public
COPY --from=builder --chown=crm:crm /app/.next/standalone ./
COPY --from=builder --chown=crm:crm /app/.next/static ./.next/static
USER crm
EXPOSE 3000
CMD ["node", "server.js"]
