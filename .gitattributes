* text=auto

# Source, documentation, and configuration use LF for stable cross-platform diffs.
*.md text eol=lf
*.txt text eol=lf
*.py text eol=lf
*.pyi text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.socket text eol=lf
Dockerfile* text eol=lf
*.lock text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.env.example text eol=lf

# Project PowerShell scripts target Windows PowerShell 5.1 and PowerShell 7.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must not be normalized as text.
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.webp -text
*.ico -text
*.pdf -text
*.docx -text
*.xlsx -text
*.zip -text
*.gz -text
*.woff -text
*.woff2 -text
*.ttf -text
*.bin -text
*.safetensors -text
*.pt -text
*.pth -text
*.onnx -text
*.gguf -text
